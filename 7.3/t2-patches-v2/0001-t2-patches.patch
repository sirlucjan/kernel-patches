+void t2bce_ave_build_cmd_set_property_float32(void *buf, const char *name, u32 ieee754_bits)
+{
+	struct t2bce_t2bce_ave_cmd_set_property *c = t2bce_ave_build_cmd_set_property_common(buf, name);
+
+	c->type = 0x00000004;
+	c->length = 0x00000004;
