+static int macsmc_hwmon_create_sensor_acpi(struct apple_smc *smc,
+		struct macsmc_hwmon_sensor *sensor, smc_key key, char *name, u32 attrs)
+{
+	int ret;
+
+	ret = apple_smc_get_key_info(smc, key, &sensor->info);
+	if (ret)
+		return ret;
+
+	sensor->macsmc_key = key;
+	sensor->label = name;
+	sensor->attrs = attrs;
+
+	return 0;
+}
 /*
