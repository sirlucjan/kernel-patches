+void t2bce_ave_build_cmd_set_property_string(void *buf, const char *name, const char *value)
+{
+	struct t2bce_t2bce_ave_cmd_set_property *c = t2bce_ave_build_cmd_set_property_common(buf, name);
+	size_t len = strlen(value);
