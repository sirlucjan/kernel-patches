From 9354611bd49f66d841ffaa36b1262923154b4ebe Mon Sep 17 00:00:00 2001
From: Atharva Tiwari <atharvatiwarilinuxdev@gmail.com>
Date: Tue, 20 Oct 2026 09:45:45 +0200
Subject: [PATCH 51/51] hwmon: macsmc: use descriptive names for power zone
 sensors

Replace the generic "Zone N" labels for the PZ0-PZ4 power zone keys
with the components they actually correspond to (heatpipe, CPU, dGPU,
auxiliary battery and battery).

Signed-off-by: Atharva Tiwari <atharvatiwarilinuxdev@gmail.com>
---
 drivers/hwmon/macsmc-hwmon.c | 40 ++++++++++++++++++------------------
 1 file changed, 20 insertions(+), 20 deletions(-)

diff --git a/drivers/hwmon/macsmc-hwmon.c b/drivers/hwmon/macsmc-hwmon.c
index 6ce4eaa08..870ee7d42 100644
--- a/drivers/hwmon/macsmc-hwmon.c
+++ b/drivers/hwmon/macsmc-hwmon.c
@@ -1224,26 +1224,26 @@ static const struct macsmc_sensor_desc power_sensors[] = {
 	{ "Thunderbolt Power (PHSP)", SMC_KEY(PHSP) },
 	{ "WiFi (PAPC)", SMC_KEY(PAPC) },
 	{ "Wifi Load-Side Power (PW0R)", SMC_KEY(PW0R) },
-	{ "Zone 0 Average (PZ0G)", SMC_KEY(PZ0G) },
-	{ "Zone 0 Average Target (PZ0E)", SMC_KEY(PZ0E) },
-	{ "Zone 0 Filtered (PZ0F)", SMC_KEY(PZ0F) },
-	{ "Zone 0 Throttle (PZ0T)", SMC_KEY(PZ0T) },
-	{ "Zone 1 Average (PZ1G)", SMC_KEY(PZ1G) },
-	{ "Zone 1 Filtered (PZ1F)", SMC_KEY(PZ1F) },
-	{ "Zone 1 Target (PZ1E)", SMC_KEY(PZ1E) },
-	{ "Zone 1 Throttle (PZ1T)", SMC_KEY(PZ1T) },
-	{ "Zone 2 Average (PZ2G)", SMC_KEY(PZ2G) },
-	{ "Zone 2 Filtered (PZ2F)", SMC_KEY(PZ2F) },
-	{ "Zone 2 Target (PZ2E)", SMC_KEY(PZ2E) },
-	{ "Zone 2 Throttle (PZ2T)", SMC_KEY(PZ2T) },
-	{ "Zone 3 Average (PZ3G)", SMC_KEY(PZ3G) },
-	{ "Zone 3 Filtered (PZ3F)", SMC_KEY(PZ3F) },
-	{ "Zone 3 Target (PZ3E)", SMC_KEY(PZ3E) },
-	{ "Zone 3 Throttle (PZ3T)", SMC_KEY(PZ3T) },
-	{ "Zone 4 Average (PZ4G)", SMC_KEY(PZ4G) },
-	{ "Zone 4 Filtered (PZ4F)", SMC_KEY(PZ4F) },
-	{ "Zone 4 Target (PZ4E)", SMC_KEY(PZ4E) },
-	{ "Zone 4 Throttle (PZ4T)", SMC_KEY(PZ4T) },
+	{ "Heatpipe Average (PZ0G)", SMC_KEY(PZ0G) },
+	{ "Heatpipe Average Target (PZ0E)", SMC_KEY(PZ0E) },
+	{ "Heatpipe Filtered (PZ0F)", SMC_KEY(PZ0F) },
+	{ "Heatpipe Throttle (PZ0T)", SMC_KEY(PZ0T) },
+	{ "CPU Average (PZ1G)", SMC_KEY(PZ1G) },
+	{ "CPU Filtered (PZ1F)", SMC_KEY(PZ1F) },
+	{ "CPU Target (PZ1E)", SMC_KEY(PZ1E) },
+	{ "CPU Throttle (PZ1T)", SMC_KEY(PZ1T) },
+	{ "dGPU Average (PZ2G)", SMC_KEY(PZ2G) },
+	{ "dGPU Filtered (PZ2F)", SMC_KEY(PZ2F) },
+	{ "dGPU Target (PZ2E)", SMC_KEY(PZ2E) },
+	{ "dGPU Throttle (PZ2T)", SMC_KEY(PZ2T) },
+	{ "Batt aux Average (PZ3G)", SMC_KEY(PZ3G) },
+	{ "Batt aux Filtered (PZ3F)", SMC_KEY(PZ3F) },
+	{ "Batt aux Target (PZ3E)", SMC_KEY(PZ3E) },
+	{ "Batt aux Throttle (PZ3T)", SMC_KEY(PZ3T) },
+	{ "Battery Average (PZ4G)", SMC_KEY(PZ4G) },
+	{ "Battery Filtered (PZ4F)", SMC_KEY(PZ4F) },
+	{ "Battery Target (PZ4E)", SMC_KEY(PZ4E) },
+	{ "Battery Throttle (PZ4T)", SMC_KEY(PZ4T) },
 	{ "Zone 5 Abstract Throttle (PZ5T)", SMC_KEY(PZ5T) },
 	{ "Zone 5 Average Power (PZ5G)", SMC_KEY(PZ5G) },
 	{ "Zone 5 Filtered Power (PZ5F)", SMC_KEY(PZ5F) },
