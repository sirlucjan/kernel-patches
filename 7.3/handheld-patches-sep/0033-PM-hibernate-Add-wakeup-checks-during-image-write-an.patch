From bb2815f863fbd15130a7a2b39278c4550129e15f Mon Sep 17 00:00:00 2001
From: Muhammad Usama Anjum <usama.anjum@collabora.com>
Date: Tue, 28 Oct 2025 16:46:45 +0500
Subject: [PATCH 033/161] PM: hibernate: Add wakeup checks during image write
 and before power down

Add pm_wakeup_pending() checks at critical points during hibernation to
allow cancellation between image creation and system poweroff,
addressing mechanism.

1. Add periodic wakeup checks in save_image() and save_compressed_image()
   at every 10% progress interval during image write. If a wakeup event
   is detected, return -EAGAIN immediately to abort the write operation.

2. Add a wakeup check at the beginning of power_down() to catch any
   wakeup events that occur after image write completes but before the
   actual power transition begins.

- Maximum cancellation latency reduced to ~1 second
- User cancellation attempts are now properly handled at all stages

Tested with rtcwake and power button presses at various stages during
hibernation. Cancellation works correctly during image write (early
abort) and after image write (image invalidation), with the system
returning to normal operation in both cases.

Signed-off-by: Muhammad Usama Anjum <usama.anjum@collabora.com>
---
 kernel/power/hibernate.c |  8 +++++++-
 kernel/power/swap.c      | 20 ++++++++++++++++++--
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/kernel/power/hibernate.c b/kernel/power/hibernate.c
index c13f68ab7..111915999 100644
--- a/kernel/power/hibernate.c
+++ b/kernel/power/hibernate.c
@@ -676,7 +676,13 @@ int hibernation_platform_enter(void)
  */
 static void power_down(void)
 {
-	int error;
+	int error = -EAGAIN;
+
+	if (pm_wakeup_pending()) {
+		pm_wakeup_clear(0);
+		pr_info("Wakeup event detected after image write, aborting power down.\n");
+		goto exit;
+	}
 
 #ifdef CONFIG_SUSPEND
 	if (hibernation_mode == HIBERNATION_SUSPEND) {
diff --git a/kernel/power/swap.c b/kernel/power/swap.c
index c78f15936..0883a6af8 100644
--- a/kernel/power/swap.c
+++ b/kernel/power/swap.c
@@ -552,9 +552,17 @@ static int save_image(struct swap_map_handle *handle,
 		ret = swap_write_page(handle, data_of(*snapshot), &hb);
 		if (ret)
 			break;
-		if (!(nr_pages % m))
+		if (!(nr_pages % m)) {
 			pr_info("Image saving progress: %3d%%\n",
 				nr_pages / m * 10);
+			/* Check for wakeup events periodically during image write */
+			if (pm_wakeup_pending()) {
+				pm_wakeup_clear(0);
+				pr_info("Wakeup pending, aborting image write\n");
+				ret = -EAGAIN;
+				break;
+			}
+		}
 		nr_pages++;
 	}
 	err2 = hib_wait_io(&hb);
@@ -820,9 +828,17 @@ static int save_compressed_image(struct swap_map_handle *handle,
 				memcpy(data[thr].unc + off,
 				       data_of(*snapshot), PAGE_SIZE);
 
-				if (!(nr_pages % m))
+				if (!(nr_pages % m)) {
 					pr_info("Image saving progress: %3d%%\n",
 						nr_pages / m * 10);
+					/* Check for wakeup events periodically during image write */
+					if (pm_wakeup_pending()) {
+						pm_wakeup_clear(0);
+						pr_info("Wakeup pending, aborting compressed image write\n");
+						ret = -EAGAIN;
+						goto out_finish;
+					}
+				}
 				nr_pages++;
 			}
 			if (!off)
