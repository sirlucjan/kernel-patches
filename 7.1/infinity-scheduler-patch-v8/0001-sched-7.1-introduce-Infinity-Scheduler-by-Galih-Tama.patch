 					    struct drm_sched_rq *rq)
 {
 	if (!RB_EMPTY_NODE(&entity->rb_tree_node)) {
@@ -151,24 +292,70 @@ static void drm_sched_rq_remove_fifo_locked(struct drm_sched_entity *entity,
