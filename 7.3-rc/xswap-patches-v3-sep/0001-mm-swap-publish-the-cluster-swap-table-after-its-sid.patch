From df037aa0156b393bbef5d28fe8fc3c97f04fd478 Mon Sep 17 00:00:00 2001
From: Peter Jung <admin@ptr1337.dev>
Date: Fri, 25 Sep 2026 16:01:20 +0200
Subject: [PATCH 01/12] mm, swap: publish the cluster swap table after its side
 tables

swap_cluster_alloc_table() sets ci->table before it allocates
ci->memcg_table and ci->zero_bitmap. cluster_is_usable() treats a
cluster with a table as usable, and CLUSTER_FLAG_NONE, the flag of an
isolated cluster, is below CLUSTER_FLAG_USABLE.

swap_cluster_populate() drops the cluster lock around the sleeping
allocation. If another CPU still caches an offset in that cluster, it
can lock the cluster in that window, pass cluster_is_usable(), and
allocate entries before the side tables exist. Their memcg IDs can then
be written to a missing or replaced memcg_table. If a later allocation
fails, the error path frees tables that the new entries already use.

Allocate the side tables first, and publish ci->table only once the
cluster is fully set up. On failure nothing has been published yet, so
swap_cluster_free_table() only frees the side tables.

Fixes: b197d41462c2 ("mm/memcg, swap: store cgroup id in cluster table directly")
Signed-off-by: Peter Jung <admin@ptr1337.dev>
---
 mm/swapfile.c | 50 +++++++++++++++++++++++++++++---------------------
 1 file changed, 29 insertions(+), 21 deletions(-)

diff --git a/mm/swapfile.c b/mm/swapfile.c
index 601979b97..0d61e2252 100644
--- a/mm/swapfile.c
+++ b/mm/swapfile.c
@@ -456,6 +456,22 @@ static int swap_cluster_alloc_table(struct swap_cluster_info *ci, gfp_t gfp)
 	if (rcu_access_pointer(ci->table))
 		return 0;
 
+#ifdef CONFIG_MEMCG
+	if (!mem_cgroup_disabled()) {
+		VM_WARN_ON_ONCE(ci->memcg_table);
+		ci->memcg_table = kzalloc_obj(*ci->memcg_table, gfp);
+		if (!ci->memcg_table)
+			goto free;
+	}
+#endif
+
+#if !SWAP_TABLE_HAS_ZEROFLAG
+	VM_WARN_ON_ONCE(ci->zero_bitmap);
+	ci->zero_bitmap = bitmap_zalloc(SWAPFILE_CLUSTER, gfp);
+	if (!ci->zero_bitmap)
+		goto free;
+#endif
+
 	if (SWP_TABLE_USE_PAGE) {
 		folio = folio_alloc(gfp | __GFP_ZERO, 0);
 		if (folio)
@@ -464,30 +480,22 @@ static int swap_cluster_alloc_table(struct swap_cluster_info *ci, gfp_t gfp)
 		table = kmem_cache_zalloc(swap_table_cachep, gfp);
 	}
 	if (!table)
-		return -ENOMEM;
+		goto free;
 
+	/*
+	 * Make tables visible to cluster_is_usable() after everything is
+	 * ready. swap_cluster_populate() drops the cluster lock for a
+	 * sleeping allocation, and a CPU still caching an offset in this
+	 * cluster may lock it and allocate from it as soon as ci->table is
+	 * set.
+	 */
 	rcu_assign_pointer(ci->table, table);
-
-#ifdef CONFIG_MEMCG
-	if (!mem_cgroup_disabled()) {
-		VM_WARN_ON_ONCE(ci->memcg_table);
-		ci->memcg_table = kzalloc_obj(*ci->memcg_table, gfp);
-		if (!ci->memcg_table) {
-			swap_cluster_free_table(ci);
-			return -ENOMEM;
-		}
-	}
-#endif
-
-#if !SWAP_TABLE_HAS_ZEROFLAG
-	VM_WARN_ON_ONCE(ci->zero_bitmap);
-	ci->zero_bitmap = bitmap_zalloc(SWAPFILE_CLUSTER, gfp);
-	if (!ci->zero_bitmap) {
-		swap_cluster_free_table(ci);
-		return -ENOMEM;
-	}
-#endif
 	return 0;
+
+free:
+	/* Nothing is published yet, so this only frees the side tables. */
+	swap_cluster_free_table(ci);
+	return -ENOMEM;
 }
 
