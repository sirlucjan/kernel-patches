+static ssize_t stats_show(struct kobject *kobj, struct kobj_attribute *attr,
+			  char *buf)
+{
+	/*
+	 * orphan_bit: self-heal count for a stale L1-bitmap-vs-state-byte
+	 * mismatch found by the scanner (marie_state_isolate_scan_l2lock's
+	 * orphaned-bit cleanup). Restored alongside the exact L1/L2 bitmap
+	 * (see state.h's paradigm-spec block): this is the same live
+	 * observability signal that first surfaced the walker-vs-isolate
+	 * race this whole ISOLATED-gate effort exists to close. With the
+	 * gate in place this should stay near zero, bounded to the narrow
+	 * residual race the gate cannot close (see
+	 * marie_state_move_to_gen's comment) -- a sustained climb is a
+	 * regression signal worth investigating, not routine noise.
+	 */
+	int len = 0, type, i;
+
+	/*
+	 * gen_ring: the aging ring itself, printed oldest-first from the slot
+	 * after the head so the reader sees it in the order reclaim consumes
+	 * it, with the head last and marked. Without this the ring is the one
+	 * part of Marie with no external view at all: whether it has
+	 * stratified (several occupied slots) or degenerated (everything in
+	 * one) decides whether promote-on-access can protect anything, and
+	 * that question has been argued from arithmetic rather than looked at.
+	 */
+	for (type = 0; type < 2; type++) {
+		int head = atomic_read(&marie_head_gen[type]);
+
+		len += sysfs_emit_at(buf, len, "gen_ring %s head %d gens %d occ",
+				     type ? "file" : "anon", head,
+				     atomic_read(&marie_nr_occupied_gens[type]));
+		for (i = 1; i <= MARIE_PFN_NR_GENS; i++) {
+			int slot = (head + i) & (MARIE_PFN_NR_GENS - 1);
+
+			len += sysfs_emit_at(buf, len, " %d:%ld%s", slot,
+				atomic_long_read(&marie_gen_occupied[slot][type]),
+				slot == head ? "(H)" : "");
+		}
+		len += sysfs_emit_at(buf, len, "\n");
+	}
+
+	return len + sysfs_emit_at(buf, len,
+			  "nr_folios %lld\n"
+			  "pick file_strict %ld anon_strict %ld file_then_anon %ld anon_first %ld file_first %ld\n"
+			  "reclaimed anon %ld file %ld\n"
+			  "orphan_bit anon %ld file %ld\n"
+			  "gen_growth_live anon %lu file %lu floor_shift %u\n"
+			  "second_chance anon activate %ld ref_keep %ld\n"
+			  "second_chance file activate %ld ref_keep %ld\n"
+			  "budget need %ld delivered %ld calls %ld max_overshoot %ld\n"
+			  "concede floor %ld free %ld refault %ld memcg %ld\n",
+			  percpu_counter_sum(&marie_nr_folios),
+			  atomic_long_read(&marie_dbg_pick[0]),
+			  atomic_long_read(&marie_dbg_pick[1]),
+			  atomic_long_read(&marie_dbg_pick[2]),
+			  atomic_long_read(&marie_dbg_pick[3]),
+			  atomic_long_read(&marie_dbg_pick[4]),
+			  atomic_long_read(&marie_dbg_reclaimed[0]),
+			  atomic_long_read(&marie_dbg_reclaimed[1]),
+			  atomic_long_read(&marie_dbg_orphan_bit[0]),
+			  atomic_long_read(&marie_dbg_orphan_bit[1]),
+			  marie_gen_growth_threshold(0),
+			  marie_gen_growth_threshold(1),
+			  READ_ONCE(marie_gen_floor_shift),
+			  atomic_long_read(&marie_dbg_second_chance[0][0]),
+			  atomic_long_read(&marie_dbg_second_chance[1][0]),
+			  atomic_long_read(&marie_dbg_second_chance[0][1]),
+			  atomic_long_read(&marie_dbg_second_chance[1][1]),
+			  atomic_long_read(&marie_dbg_budget[0]),
+			  atomic_long_read(&marie_dbg_budget[1]),
+			  atomic_long_read(&marie_dbg_budget[2]),
+			  atomic_long_read(&marie_dbg_budget[3]),
+			  atomic_long_read(&marie_dbg_concede[0]),
+			  atomic_long_read(&marie_dbg_concede[1]),
+			  atomic_long_read(&marie_dbg_concede[2]),
+			  atomic_long_read(&marie_dbg_concede[3]));
+}
+
+static struct kobj_attribute marie_stats_attr = __ATTR_RO(stats);
