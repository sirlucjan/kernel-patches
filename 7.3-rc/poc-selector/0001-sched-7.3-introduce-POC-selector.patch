+/* boot param: lru_marie=0 / lru_marie=1. Marie is selected ONCE here, at boot,
+ * before the cgroup tree is populated and before any lruvec carries folios, so
+ * a plain static-key toggle is sufficient -- there is nothing tracked to drain
+ * or fill. Runtime toggling is not supported (desktop/global-only). */
+static int __init marie_setup(char *str)
+{
+	int v;
+
+	if (!str || kstrtoint(str, 0, &v))
+		return 0;
+	if (v)
+		static_branch_enable(&lru_marie_enabled_key);
+	else
+		static_branch_disable(&lru_marie_enabled_key);
+	return 1;
+}
+__setup("lru_marie=", marie_setup);
+
+/*
+ * boot param: lru_marie_max_l2_pages_per_bit=<N>. Overrides
+ * MARIE_MAX_L2_PAGES_PER_BIT_DEFAULT (bitmap.h) for marie_track_bm's L2
+ * summary granularity. Boot-only, not sysfs: marie_bm_global_init()
+ * (marie_state_init(), subsys_initcall) consumes marie_max_l2_pages_per_bit
+ * to size the L2/range-lock arrays before any folio is ever tracked, and
+ * resizing them live is not supported. A value of 0 (or an unparsable
+ * string) is ignored, leaving the compile-time default in effect.
+ */
+static int __init marie_max_l2_pages_per_bit_setup(char *str)
+{
+	unsigned int v;
+
+	if (!str || kstrtouint(str, 0, &v) || !v)
+		return 0;
+	marie_max_l2_pages_per_bit = v;
+	return 1;
+}
+__setup("lru_marie_max_l2_pages_per_bit=", marie_max_l2_pages_per_bit_setup);
+
