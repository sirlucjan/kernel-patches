+#include "../internal.h"	/* folio_pte_batch_flags / FPB_MERGE_YOUNG_DIRTY */
+#include "walker_compat.h"	/* marie_folio_pte_batch, lazy_mmu / young-ptes shims */
+#include "state.h"
