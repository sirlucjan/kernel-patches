From 4731adf7e9f8f921cf4797321abb25b428187334 Mon Sep 17 00:00:00 2001
From: Piotr Gorski <lucjan.lucjanov@gmail.com>
Date: Mon, 28 Sep 2026 11:52:06 +0200
Subject: [PATCH] sched-7.3: introduce POC selector

Signed-off-by: Piotr Gorski <lucjan.lucjanov@gmail.com>
---
 include/linux/sched.h          |   23 +
 include/linux/sched/topology.h |   31 +
 init/Kconfig                   |   13 +
 kernel/sched/core.c            |    4 +
 kernel/sched/ext/ext.c         |    7 +
 kernel/sched/fair.c            |  168 ++-
 kernel/sched/idle.c            |   10 +
 kernel/sched/poc_selector.c    | 2261 ++++++++++++++++++++++++++++++++
 kernel/sched/poc_selector.h    |  129 ++
 kernel/sched/poc_sync.h        |  143 ++
 kernel/sched/sched.h           |    7 +
 kernel/sched/topology.c        |    3 +
 12 files changed, 2762 insertions(+), 37 deletions(-)
 create mode 100644 kernel/sched/poc_selector.c
 create mode 100644 kernel/sched/poc_selector.h
 create mode 100644 kernel/sched/poc_sync.h

diff --git a/include/linux/sched.h b/include/linux/sched.h
index d35ae49a9..018dc49ce 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -814,6 +814,26 @@ struct wake_q_node {
 	struct wake_q_node *next;
 };
 
+#ifdef CONFIG_SCHED_POC_SELECTOR
+/* Learned WF_SYNC honesty of a waker, see kernel/sched/fair.c */
+struct poc_sync {
+	u64				mark;		/* own exec at the pending sync wake + 1, 0 = none */
+	u16				hist;		/* last 16 resolved sync wakes, bit = 1: a lie */
+	u16				chain;		/* same 16, bit = 1: more sync wakes joined it */
+	u8				lie_log2;	/* log2 of how long a lie ran on, in ns, rounded up */
+	u8				on_waker_cpu:1;	/* pending wake's wakee on our CPU may preempt us */
+	u8				sampled:1;	/* hist holds at least one resolved sync wake */
+	u8				joined:1;	/* the pending wake has had others join it */
+	u8				explore:4;	/* preemptible handoffs, wraps: 0 = sample one */
+};
+
+/*
+ * a new task: 16 lies of 16us each, so it earns a handoff by 16 honest wakes;
+ * no chained wakes, as only an observed one should count
+ */
+#define POC_SYNC_INIT	((struct poc_sync){ .hist = 0xffff, .lie_log2 = 14 })
+#endif
+
 struct kmap_ctrl {
 #ifdef CONFIG_KMAP_LOCAL
 	int				idx;
@@ -887,6 +907,9 @@ struct task_struct {
 	unsigned int			rt_priority;
 
 	struct sched_entity		se;
+#ifdef CONFIG_SCHED_POC_SELECTOR
+	struct poc_sync			poc_sync;
+#endif
 	struct sched_rt_entity		rt;
 	struct sched_dl_entity		dl;
 	struct sched_dl_entity		*dl_server;
diff --git a/include/linux/sched/topology.h b/include/linux/sched/topology.h
index f96812d71..91bedca5b 100644
--- a/include/linux/sched/topology.h
+++ b/include/linux/sched/topology.h
@@ -86,6 +86,37 @@ struct sched_domain_shared {
 	unsigned long	util_avg;
 	unsigned long	capacity;
 #endif
+#ifdef CONFIG_SCHED_POC_SELECTOR
+	/*
+	 * POC Selector: per-LLC idle CPU tracking
+	 */
+	u64		poc_llc_members;	/* bitmask of valid CPUs (relative to base) */
+	int		poc_cpu_base;		/* smallest CPU ID in this LLC */
+	u8		poc_affinity_shift;	/* bit shift for cpumask alignment */
+	bool	poc_fast_eligible;	/* true when LLC CPU count <= 64 */
+	bool	poc_cluster_valid;	/* true when cluster mask is usable */
+#ifdef CONFIG_SCHED_SMT
+	u8		poc_smt_shift;		/* bit distance between SMT siblings */
+	u64		poc_primary_mask;	/* bitmask of core representative CPUs */
+#endif
+
+	/*
+	 * Lazy commit: reader-facing busy mask + pending bits.
+	 * Readers: single atomic64_read (MOV on x86); idle = ~busy.
+	 * Writers: atomic_or / atomic64_set on the shared cacheline.
+	 */
+	atomic64_t	poc_busy_mask ____cacheline_aligned;
+	atomic_t	poc_pending[8] ____cacheline_aligned;	/* 8 chunks x 8 LLC CPUs */
+
+	/*
+	 * Read-only lookup tables (written once at init).
+	 * Cacheline-aligned for exact prefetch targeting.
+	 */
+	u64		poc_cluster_mask[64] ____cacheline_aligned;
+#ifdef CONFIG_SCHED_SMT
+	u64		poc_smt_mask[64] ____cacheline_aligned;
+#endif /* CONFIG_SCHED_SMT */
+#endif /* CONFIG_SCHED_POC_SELECTOR */
 };
 
 struct sched_domain {
diff --git a/init/Kconfig b/init/Kconfig
index 8583d9f06..145429cc7 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -1501,6 +1501,19 @@ config SCHED_AUTOGROUP
 	  desktop applications.  Task group autogeneration is currently based
 	  upon task session.
 
+config SCHED_POC_SELECTOR
+	bool "Piece-Of-Cake Fast Idle CPU Selector"
+	depends on SMP
+	default y
+	help
+	  Idle CPU selector using cached bitmasks inspired by the scx_cake BPF
+	  scheduler. Reduces select_idle_cpu overhead by using bitmap scanning.
+
+	  This optimization does not affect scheduler fairness - it only
+	  speeds up the process of finding an idle CPU for task wakeup.
+
+	  If unsure, say Y.
+
 config RELAY
 	bool "Kernel->user space relay support (formerly relayfs)"
 	select IRQ_WORK
diff --git a/kernel/sched/core.c b/kernel/sched/core.c
index 1fe40de6e..e3654def4 100644
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -4596,6 +4596,10 @@ static void __sched_fork(u64 clone_flags, struct task_struct *p)
 	p->se.vlag			= 0;
 	p->se.rel_deadline		= 0;
 	INIT_LIST_HEAD(&p->se.group_node);
+#ifdef CONFIG_SCHED_POC_SELECTOR
+	/* no history yet: treat the new task's sync wakes as lies until proven */
+	p->poc_sync = POC_SYNC_INIT;
+#endif
 
 	/* A delayed task cannot be in clone(). */
 	WARN_ON_ONCE(p->se.sched_delayed);
diff --git a/kernel/sched/ext/ext.c b/kernel/sched/ext/ext.c
index e56c3c950..749ded0c8 100644
--- a/kernel/sched/ext/ext.c
+++ b/kernel/sched/ext/ext.c
@@ -6628,6 +6628,9 @@ static void scx_root_disable(struct scx_sched *sch)
 	mutex_unlock(&scx_enable_mutex);
 
 	WARN_ON_ONCE(scx_set_enable_state(SCX_DISABLED) != SCX_DISABLING);
+#ifdef CONFIG_SCHED_POC_SELECTOR
+	poc_notify_scx(false);
+#endif
 done:
 	scx_bypass(sch, false);
 }
@@ -7932,6 +7935,10 @@ static void scx_root_enable_workfn(struct kthread_work *work)
 		}
 	}
 
+#ifdef CONFIG_SCHED_POC_SELECTOR
+	poc_notify_scx(true);
+#endif
+
 	pr_info("sched_ext: BPF scheduler \"%s\" enabled%s\n",
 		sch->ops.name, scx_switched_all() ? "" : " (partial)");
 	kobject_uevent(&sch->kobj, KOBJ_ADD);
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 57360f5cd..ae5e718c7 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -1313,7 +1313,7 @@ static bool update_deadline(struct cfs_rq *cfs_rq, struct sched_entity *se)
 
 #include "pelt.h"
 
-static int select_idle_sibling(struct task_struct *p, int prev_cpu, int cpu);
+static int select_idle_sibling(struct task_struct *p, int prev_cpu, int cpu, int sync);
 static unsigned long task_h_load(struct task_struct *p);
 static unsigned long capacity_of(int cpu);
 
@@ -8401,6 +8401,10 @@ static bool __dequeue_task(struct rq *rq, struct task_struct *p, int flags)
 	return true;
 }
 
+#ifdef CONFIG_SCHED_POC_SELECTOR
+#include "poc_sync.h"
+#endif
+
 /*
  * The dequeue_task method is called before nr_running is
  * decreased. We remove the task from the rbtree and
@@ -8413,6 +8417,10 @@ static bool dequeue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 		return true;
 	}
 
+#ifdef CONFIG_SCHED_POC_SELECTOR
+	if (flags & DEQUEUE_SLEEP)
+		poc_sync_note_sleep(rq, p);
+#endif
 	if (!p->se.sched_delayed)
 		util_est_dequeue(&rq->cfs, p);
 
@@ -8840,6 +8848,20 @@ void __update_idle_core(struct rq *rq)
 	rcu_read_unlock();
 }
 
+/*
+ * Check if the entire core (all SMT siblings) containing @cpu is idle.
+ */
+static inline bool is_idle_core(int cpu)
+{
+	int sibling;
+
+	for_each_cpu(sibling, cpu_smt_mask(cpu)) {
+		if (!available_idle_cpu(sibling))
+			return false;
+	}
+	return true;
+}
+
 /*
  * Scan the entire LLC domain for idle cores; this dynamically switches off if
  * there are no idle cores left in the system; tracked through
@@ -9167,16 +9189,55 @@ static inline bool asym_fits_cpu(unsigned long util,
 	return true;
 }
 
+#ifdef CONFIG_SCHED_POC_SELECTOR
+#include "poc_selector.c"
+#endif
 /*
  * Try and locate an idle core/thread in the LLC cache domain.
  */
-static int select_idle_sibling(struct task_struct *p, int prev, int target)
+static int select_idle_sibling(struct task_struct *p, int prev, int target, int sync)
 {
 	bool has_idle_core = false;
 	struct sched_domain *sd;
 	unsigned long task_util, util_min, util_max;
 	int i, recent_used_cpu, prev_aff = -1;
 
+	/* Check a recently used CPU as a potential idle candidate: */
+	recent_used_cpu = p->recent_used_cpu;
+	p->recent_used_cpu = prev;
+	if (recent_used_cpu != prev &&
+	    recent_used_cpu != target &&
+	    cpus_share_cache(recent_used_cpu, target) &&
+	    choose_idle_cpu(recent_used_cpu, p) &&
+	    cpumask_test_cpu(recent_used_cpu, p->cpus_ptr)) {
+#ifdef CONFIG_SCHED_POC_SELECTOR
+		if (poc_sync_recent_ok())
+#endif
+		if ((unsigned int)recent_used_cpu < nr_cpumask_bits &&
+		    is_idle_core(recent_used_cpu)) {
+			/*
+			 * recent_used_cpu is the CPU the task ran on before
+			 * prev.  Never prefer it over an idle prev core, or a
+			 * task that wakes on an idle machine ping-pongs between
+			 * the two, paying a cold core on every wakeup.
+			 */
+			int cpu = recent_used_cpu;
+
+			if (cpumask_test_cpu(prev, p->cpus_ptr) &&
+			    cpus_share_cache(prev, target) && is_idle_core(prev))
+				cpu = prev;
+#ifdef CONFIG_SCHED_POC_SELECTOR
+			if (static_branch_likely(&poc_selector_active)) {
+				poc_count(cpu == prev ? POC_LV1P : POC_LV1R);
+				poc_commit_cpu(cpu);
+			}
+#endif
+			return cpu;
+		}
+	} else {
+		recent_used_cpu = -1;
+	}
+
 	/*
 	 * On asymmetric system, update task utilization because we will check
 	 * that the task fits with CPU's capacity.
@@ -9193,23 +9254,15 @@ static int select_idle_sibling(struct task_struct *p, int prev, int target)
 	 */
 	lockdep_assert_irqs_disabled();
 
-	if (choose_idle_cpu(target, p) &&
-	    asym_fits_cpu(task_util, util_min, util_max, target))
+#ifdef CONFIG_SCHED_POC_SELECTOR
+	if (static_branch_likely(&poc_selector_active) &&
+	    is_idle_core(target) &&
+	    asym_fits_cpu(task_util, util_min, util_max, target)) {
+		poc_count(POC_LV1T);
+		poc_commit_cpu(target);
 		return target;
-
-	/*
-	 * If the previous CPU is cache affine and idle, don't be stupid:
-	 */
-	if (prev != target && cpus_share_cache(prev, target) &&
-	    choose_idle_cpu(prev, p) &&
-	    asym_fits_cpu(task_util, util_min, util_max, prev)) {
-
-		if (!static_branch_unlikely(&sched_cluster_active) ||
-		    cpus_share_resources(prev, target))
-			return prev;
-
-		prev_aff = prev;
 	}
+#endif
 
 	/*
 	 * Allow a per-cpu kthread to stack with the wakee if the
@@ -9227,24 +9280,6 @@ static int select_idle_sibling(struct task_struct *p, int prev, int target)
 		return prev;
 	}
 
-	/* Check a recently used CPU as a potential idle candidate: */
-	recent_used_cpu = p->recent_used_cpu;
-	p->recent_used_cpu = prev;
-	if (recent_used_cpu != prev &&
-	    recent_used_cpu != target &&
-	    cpus_share_cache(recent_used_cpu, target) &&
-	    choose_idle_cpu(recent_used_cpu, p) &&
-	    cpumask_test_cpu(recent_used_cpu, p->cpus_ptr) &&
-	    asym_fits_cpu(task_util, util_min, util_max, recent_used_cpu)) {
-
-		if (!static_branch_unlikely(&sched_cluster_active) ||
-		    cpus_share_resources(recent_used_cpu, target))
-			return recent_used_cpu;
-
-	} else {
-		recent_used_cpu = -1;
-	}
-
 	/*
 	 * For asymmetric CPU capacity systems, our domain of interest is
 	 * sd_asym_cpucapacity rather than sd_llc.
@@ -9269,6 +9304,46 @@ static int select_idle_sibling(struct task_struct *p, int prev, int target)
 	if (!sd)
 		return target;
 
+#ifdef CONFIG_SCHED_POC_SELECTOR
+	{
+		int poc_cpu = poc_select_idle_sibling(p, prev, target,
+						      recent_used_cpu);
+
+		if (poc_cpu >= 0)
+			return poc_cpu;
+		if (unlikely(poc_cpu == -2))
+			goto give_up;
+	}
+#endif
+
+	if ((unsigned int)recent_used_cpu < nr_cpumask_bits) {
+		if (choose_idle_cpu(recent_used_cpu, p)) {
+			if (is_idle_core(recent_used_cpu))
+				return recent_used_cpu;
+			/* idle CPU but not idle core → preserve for give_up */
+		} else {
+			recent_used_cpu = -1;  /* not idle → discard */
+		}
+	}
+
+	if (sync && is_idle_core(target) &&
+	    asym_fits_cpu(task_util, util_min, util_max, target))
+		return target;
+
+	/*
+	 * If the previous CPU is cache affine and idle, don't be stupid:
+	 */
+	if (prev != target && cpus_share_cache(prev, target) &&
+	    choose_idle_cpu(prev, p) &&
+	    asym_fits_cpu(task_util, util_min, util_max, prev)) {
+
+		if (!static_branch_unlikely(&sched_cluster_active) ||
+		    cpus_share_resources(prev, target))
+			return prev;
+
+		prev_aff = prev;
+	}
+
 	if (sched_smt_active()) {
 		has_idle_core = test_idle_cores(target);
 
@@ -9283,6 +9358,9 @@ static int select_idle_sibling(struct task_struct *p, int prev, int target)
 	if ((unsigned)i < nr_cpumask_bits)
 		return i;
 
+#ifdef CONFIG_SCHED_POC_SELECTOR
+give_up:
+#endif
 	/*
 	 * For cluster machines which have lower sharing cache like L2 or
 	 * LLC Tag, we tend to find an idle CPU in the target's cluster
@@ -9294,6 +9372,9 @@ static int select_idle_sibling(struct task_struct *p, int prev, int target)
 	if ((unsigned int)recent_used_cpu < nr_cpumask_bits)
 		return recent_used_cpu;
 
+#ifdef CONFIG_SCHED_POC_SELECTOR
+	target = poc_last_resort(prev, target);
+#endif
 	return target;
 }
 
@@ -9975,8 +10056,13 @@ select_task_rq_fair(struct task_struct *p, int prev_cpu, int wake_flags)
 		return sched_balance_find_dst_cpu(sd, p, cpu, prev_cpu, sd_flag);
 
 	/* Fast path */
-	if (wake_flags & WF_TTWU)
-		return select_idle_sibling(p, prev_cpu, new_cpu);
+	if (wake_flags & WF_TTWU) {
+#ifdef CONFIG_SCHED_POC_SELECTOR
+		if (static_branch_likely(&poc_selector_active))
+			return poc_select_wake_cpu(p, prev_cpu, new_cpu, sync);
+#endif
+		return select_idle_sibling(p, prev_cpu, new_cpu, sync);
+	}
 
 	return new_cpu;
 }
@@ -10130,6 +10216,10 @@ static void wakeup_preempt_fair(struct rq *rq, struct task_struct *p, int wake_f
 	struct sched_entity *nse, *se = &donor->se, *pse = &p->se;
 	struct cfs_rq *cfs_rq = &rq->cfs;
 	int cse_is_idle, pse_is_idle;
+#ifdef CONFIG_SCHED_POC_SELECTOR
+	/* the task running here, the waker if this is a local sync wake */
+	struct task_struct *curr = rq->curr;
+#endif
 
 	/*
 	 * XXX Getting preempted by higher class, try and find idle CPU?
@@ -10138,6 +10228,10 @@ static void wakeup_preempt_fair(struct rq *rq, struct task_struct *p, int wake_f
 	    donor->sched_class != &fair_sched_class)
 		return;
 
+#ifdef CONFIG_SCHED_POC_SELECTOR
+	if (poc_sync_wakee_waits(rq, curr, p, wake_flags))
+		return;
+#endif
 	if (unlikely(se == pse))
 		return;
 
