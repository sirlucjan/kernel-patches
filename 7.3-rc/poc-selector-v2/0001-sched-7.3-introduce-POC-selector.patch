+
+/**************************************************************
+ * WF_SYNC honesty: wakeup-time hooks, called from fair.c:
+ */
+
+/* current's own CPU time now, without the rq lock */
+static inline u64 poc_curr_exec(struct rq *rq)
+{
+	struct sched_entity *se = &current->se;
+	u64 now = READ_ONCE(rq->clock_task) + (local_clock() - READ_ONCE(rq->clock));
+	s64 delta = (s64)(now - se->exec_start);
+
+	return se->sum_exec_runtime + (delta > 0 ? delta : 0);
+}
+
+/*
+ * current issues a WF_SYNC wake.  A pending one less than POC_SYNC_LIE_NS
+ * ago can still be kept by sleeping soon: this wake joins it, and both
+ * are resolved together by the earlier mark.  An older one is a lie
+ * already, as current has not slept; this wake then starts a new mark.
+ */
+static inline void poc_sync_note_wake(struct rq *rq)
+{
+	struct poc_sync *ps = &current->poc_sync;
+	u64 now = poc_curr_exec(rq);
+
+	if (ps->mark) {
+		if (now - (ps->mark - 1) <= POC_SYNC_LIE_NS) {
+			ps->joined = true;
+			return;
+		}
+		poc_sync_resolve(current, now - (ps->mark - 1));
+	}
+	ps->mark = now + 1;
+	ps->on_waker_cpu = false;
+	ps->joined = false;
+}
+
+/*
+ * May @p take the CPU of current, its sync waker?  Only if wake_affine()
+ * pulled it there (@target) and nothing else is queued there.  Unlike
+ * wake_affine_idle(), count delayed-dequeue entities: such a task is asleep
+ * but comes back to this very CPU through ttwu_runnable() when woken, so a
+ * hub pulled onto a partner's CPU must not be handed the first wakee of its
+ * next burst there as well.  It must pay for both: once they share the
+ * CPU, @p in turn sync-wakes current there, and a lie then serialises them
+ * as surely as current's own.  A wakee that never issued a sync wake has
+ * no say: how its other wakeups are handled is EEVDF's business.
+ */
+static inline u8 poc_sync_decide(struct task_struct *p, int prev, int target)
+{
+	int cpu = smp_processor_id();
+	struct rq *rq = cpu_rq(cpu);
+
+	if (!static_branch_likely(&sched_poc_waker_yield) ||
+	    target != cpu ||
+	    rq->nr_running > 1 ||
+	    !cpus_share_cache(cpu, prev) ||
+	    !cpumask_test_cpu(cpu, p->cpus_ptr) ||
+	    !poc_sync_waker_trusted(current) ||
+	    !poc_sync_wakee_trusted(p))
+		return POC_SYNC_NO;
+	return POC_SYNC_YES;
+}
+
+/*
+ * select_idle_sibling() hook, once the early idle-core checks found
+ * nothing.  Returns the CPU POC picked, -1 to let CFS search on, or -2 to
+ * skip CFS's search as well.
+ *
+ * POC returns -2 when the SIS_UTIL overload gate fires (smt_fallback=0 and
+ * greedy_search=0 only).  POC has already checked prev's SMT sibling
+ * (Level 4) and decided broader search is not worthwhile.  CFS would reach
+ * the same conclusion, so skip select_idle_smt/select_idle_cpu.
+ *
+ * POC returns -1 for Level 0s saturation (no idle CPUs in bitmap), but CFS
+ * may still find sched_idle CPUs, so we must NOT skip CFS in that case.
+ */
+static __always_inline int poc_select_idle_sibling(struct task_struct *p,
+						   int prev, int target,
+						   int recent)
+{
+	struct sched_domain_shared *sd_share =
+		rcu_dereference(per_cpu(sd_llc_shared, target));
+
+	if (static_branch_likely(&poc_selector_active)
+			&& !sched_asym_cpucap_active()
+			&& sd_share && likely(sd_share->poc_fast_eligible)) {
+		int cpu = select_idle_cpu_poc(target, prev, recent,
+					      sd_share, p, p->cpus_ptr);
+
+		if (cpu != -1)
+			return cpu;
+	} else {
+		/*
+		 * poc_selector_active is off -- POC is either disabled by
+		 * sysctl or suppressed while scx is running.  If an scx
+		 * scheduler called us, flip poc_selector_skip and schedule a
+		 * workqueue item to re-enable POC with bitmap resync.
+		 */
+		poc_check_skip_fallback();
+	}
+	poc_count(POC_FALLBACK);
+	return -1;
+}
+
+/* select_idle_sibling()'s last resort: avoid enqueuing behind RT/DL tasks on target */
+static __always_inline int poc_last_resort(int prev, int target)
+{
+	if (static_branch_likely(&poc_selector_active) &&
+	    rt_task(cpu_rq(target)->curr) &&
+	    prev != target && !rt_task(cpu_rq(prev)->curr))
+		return prev;
+	return target;
+}
+
+/* the fast path of select_task_rq_fair() with POC active */
+static int poc_select_wake_cpu(struct task_struct *p, int prev, int target, int sync)
+{
+	int cpu = smp_processor_id();
+	bool learn = sync && in_task() && current->sched_class == &fair_sched_class;
+	u8 verdict = POC_SYNC_NO;
+	int new_cpu;
+
+	if (learn) {
+		poc_sync_note_wake(cpu_rq(cpu));
+		__this_cpu_write(poc_sync_noted, p);
+		verdict = poc_sync_decide(p, prev, target);
+	}
+	__this_cpu_write(poc_sync_verdict, verdict);
+
+	/* not the waker's CPU: an idle prev core is the cheapest place */
+	if (verdict == POC_SYNC_NO && !sched_asym_cpucap_active() &&
+	    cpumask_test_cpu(prev, p->cpus_ptr) && is_idle_core(prev)) {
+		p->recent_used_cpu = prev;
+		poc_count(POC_LV1P);
+		poc_commit_cpu(prev);
+		new_cpu = prev;
+	} else {
+		new_cpu = select_idle_sibling(p, prev, target, sync);
+	}
+
+	return new_cpu;
+}
+
+/*
+ * A sync wakee on its waker's CPU.  A trusted waker
+ * (poc_sync_waker_trusted()) sleeps within POC_SYNC_LIE_NS of its own
+ * CPU time or lies briefly.  If it may still have more sync wakes to
+ * issue (poc_sync_waker_busy()), let the wakee wait for it to sleep
+ * rather than cut off the rest of the burst for the wakee's whole
+ * run.  Otherwise the wakee preempts: it answers before the waker
+ * blocks, which spares the waker a sleep and a wakeup.  Every 16th
+ * such wake (the explore counter wrapping) waits instead, so that the
+ * waker is still seen doing what it would anyway.  A preempting
+ * wakee's wake is not learned from, liar's or not: what the waker does
+ * next is then not its own choice.  A wake that came through
+ * ttwu_runnable() did not pass poc_select_wake_cpu(): note it here.
+ */
+static bool poc_sync_wakee_waits(struct rq *rq, struct task_struct *curr,
+				 struct task_struct *p, int wake_flags)
+{
+	struct poc_sync *ps = &curr->poc_sync;
+
+	if (!(wake_flags & WF_SYNC) || curr != current || !in_task() ||
+	    !static_branch_likely(&poc_selector_active))
+		return false;
+	if (__this_cpu_read(poc_sync_noted) != p)
+		poc_sync_note_wake(rq);
+	__this_cpu_write(poc_sync_noted, NULL);
+	if (static_branch_likely(&sched_poc_waker_yield) &&
+	    poc_sync_waker_trusted(curr) &&
+	    (poc_sync_waker_busy(curr) || !++ps->explore))
+		return true;
+	ps->on_waker_cpu = true;
+	return false;
+}
+
+#endif /* CONFIG_SCHED_POC_SELECTOR */
diff --git a/kernel/sched/poc_selector.h b/kernel/sched/poc_selector.h
new file mode 100644
index 000000000..6e7e1faa6
--- /dev/null
+++ b/kernel/sched/poc_selector.h
@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Piece-Of-Cake (POC) CPU Selector: declarations and inline helpers shared
+ * by the scheduler core.
+ *
+ * Included from kernel/sched/sched.h.  Like poc_selector.c, this file is
+ * meant to be identical on every kernel POC is ported to; what differs per
+ * kernel version lives in the hook sites.
+ */
+#ifndef _KERNEL_SCHED_POC_SELECTOR_H
+#define _KERNEL_SCHED_POC_SELECTOR_H
+
+#ifdef CONFIG_SCHED_POC_SELECTOR
+extern struct static_key_true poc_selector_active;
+#ifdef CONFIG_SCHED_CLASS_EXT
+extern void poc_notify_scx(bool scx_active);
+extern void poc_check_skip_fallback(void);
+#else
+static inline void poc_check_skip_fallback(void) {}
+#endif
+extern struct static_key_true sched_poc_aligned;
+extern struct static_key_true sched_poc_smt_consecutive;
+extern struct static_key_true sched_poc_smt_uniform;
+extern struct static_key_false sched_poc_target_sticky;
+extern struct static_key_true sched_poc_packed;
+extern void __set_cpu_idle_state_poc(int cpu, int state);
+extern struct static_key_true sched_poc_waker_yield;
+void poc_aggregate(struct sched_domain_shared *sd_share);
+void poc_commit_cpu(int cpu);
+extern unsigned int poc_pull_budget;
+extern void poc_sd_shared_init(struct sched_domain *sd, int sd_id);
+static __always_inline void set_cpu_idle_state_poc(int cpu, int state)
+{
+	if (static_branch_likely(&poc_selector_active) &&
+	    !sched_asym_cpucap_active())
+		__set_cpu_idle_state_poc(cpu, state);
+}
+
+/*
+ * POC_CTZ64 - Count trailing zeros (find first set bit)
+ *
+ * Architecture-optimized CTZ for POC idle CPU selection.
+ * Returns 64 for input 0 (important for BSF-based implementations).
+ */
+#if defined(__x86_64__) && defined(__BMI__)
+/* Tier 1: x86-64 with BMI1 - TZCNT is zero-safe */
+#define POC_CTZ64(v) ((int)__builtin_ctzll(v))
+
+#elif defined(__aarch64__)
+/* Tier 1: ARM64 - RBIT+CLZ is zero-safe */
+#define POC_CTZ64(v) ((int)__builtin_ctzll(v))
+
+#elif defined(__riscv) && defined(__riscv_zbb)
+/* Tier 1: RISC-V with Zbb - CTZ is zero-safe */
+#define POC_CTZ64(v) ((int)__builtin_ctzll(v))
+
+#elif defined(__x86_64__)
+/* Tier 2: x86-64 without BMI1 - BSF needs zero check */
+static __always_inline int poc_ctz64_bsf(u64 v)
+{
+	if (unlikely(!v))
+		return 64;
+	return (int)__builtin_ctzll(v);
+}
+#define POC_CTZ64(v) poc_ctz64_bsf(v)
+
+#else
+/* Tier 3: De Bruijn fallback for other architectures */
+#define POC_DEBRUIJN_CTZ64_CONST 0x03F79D71B4CA8B09ULL
+static const u8 poc_debruijn_ctz64_tab[64] = {
+	 0,  1, 56,  2, 57, 49, 28,  3,
+	61, 58, 42, 50, 38, 29, 17,  4,
+	62, 47, 59, 36, 45, 43, 51, 22,
+	53, 39, 33, 30, 24, 18, 12,  5,
+	63, 55, 48, 27, 60, 41, 37, 16,
+	46, 35, 44, 21, 52, 32, 23, 11,
+	54, 26, 40, 15, 34, 20, 31, 10,
+	25, 14, 19,  9, 13,  8,  7,  6,
+};
+static __always_inline int poc_debruijn_ctz64(u64 v)
+{
+	u64 lsb;
+	u32 idx;
+
+	if (unlikely(!v))
+		return 64;
+	lsb = v & (-(s64)v);
+	idx = (u32)((lsb * POC_DEBRUIJN_CTZ64_CONST) >> 58);
+	return (int)poc_debruijn_ctz64_tab[idx & 63];
+}
+#define POC_CTZ64(v) poc_debruijn_ctz64(v)
+
+#endif /* POC_CTZ64 */
+
+/*
+ * POC helper: convert cpumask region to POC-relative u64
+ *
+ * Extracts the 64-bit region of @mask corresponding to this LLC's
+ * CPU range and shifts it to align with POC's bit positions.
+ *
+ * Used by load balancer functions that need to intersect cpumasks
+ * with POC idle bitmaps.
+ */
+static __always_inline u64 poc_cpumask_to_u64(const struct cpumask *mask,
+					      struct sched_domain_shared *sd_share)
+{
+	int base = sd_share->poc_cpu_base;
+	int base_word = base >> 6;
+	int shift = sd_share->poc_affinity_shift;
+
+	if (likely(shift == 0)) {
+		/*
+		 * Fast path: this LLC's own base is 64-aligned, so no
+		 * cross-word shift is needed here even if some other LLC
+		 * in the system is misaligned (sched_poc_aligned is a
+		 * single system-wide flag and must not gate this branch).
+		 */
+		return cpumask_bits(mask)[base_word];
+	} else {
+		/* Slow path: shift required (e.g., Threadripper) */
+		u64 lo = cpumask_bits(mask)[base_word];
+		u64 hi = (base_word + 1 < BITS_TO_LONGS(nr_cpumask_bits)) ?
+			 cpumask_bits(mask)[base_word + 1] : 0;
+		return (lo >> shift) | (hi << (64 - shift));
+	}
+}
+#endif /* CONFIG_SCHED_POC_SELECTOR */
+
+#endif /* _KERNEL_SCHED_POC_SELECTOR_H */
diff --git a/kernel/sched/poc_sync.h b/kernel/sched/poc_sync.h
new file mode 100644
index 000000000..e645ed7be
--- /dev/null
+++ b/kernel/sched/poc_sync.h
@@ -0,0 +1,143 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Piece-Of-Cake (POC) CPU Selector: learned WF_SYNC honesty, the per-task
+ * history and the verdicts drawn from it.
+ *
+ * Included once, from kernel/sched/fair.c ahead of dequeue_task_fair(),
+ * whose sleep hook resolves a task's pending sync wake; the wakeup-time
+ * hooks live at the end of poc_selector.c.  It defines per-CPU variables
+ * and static functions, so no other file may include it.  Like
+ * poc_selector.c, it is meant to be identical on every kernel POC is
+ * ported to.
+ */
+
+/*
+ * Learned WF_SYNC honesty.
+ *
+ * WF_SYNC promises that the waker sleeps right after the wakeup, and POC's
+ * waker-yield hands the wakee the waker's CPU on that promise.  Callers that
+ * wake at the end of a syscall (pipe_write(), sock_def_readable(), ...)
+ * cannot know what userspace does next, so the promise is often broken and
+ * the wakee then waits behind a waker that keeps running.
+ *
+ * Each task therefore remembers its last 16 sync wakes.  One was honest if the
+ * waker slept after burning at most POC_SYNC_LIE_NS of its own CPU time, and a
+ * lie once it burned more without sleeping.  Sync wakes issued within that
+ * window of a pending one join it and are resolved with it, by the time from
+ * the first: a waker that wakes several tasks back to back and then sleeps
+ * kept its promise, one that then keeps running broke it.
+ *
+ * Whether a handoff pays is a cost comparison.  A kept promise gains about
+ * what an honest waker may still run, POC_SYNC_LIE_NS: warm caches and no
+ * idle exit.  A lie serialises the wakee behind the waker for as long as the
+ * waker then runs, so each task also keeps the log2 length of its lies,
+ * rounded up and averaged in the log domain.  A waker is trusted if
+ * lies * 2^lie_log2 <= honest * POC_SYNC_LIE_NS over those 16 wakes
+ * (poc_sync_waker_trusted()).  Only the order of magnitude matters: the
+ * gain and the cost of a lie are an order apart or more.  Both estimates
+ * err towards no handoff: a lie is rounded up to a power of two,
+ * overstating it by up to 2x, and the waker's lie length overstates the
+ * cost when the wakee runs shorter.  The wakee may take the waker's CPU
+ * only when the waker is trusted and, if the wakee has issued sync wakes,
+ * it is trusted as well (poc_sync_wakee_trusted()); otherwise an idle prev
+ * core, or the normal search without waker-yield, is used.
+ *
+ * A wakee on its waker's CPU preempts it unless the waker is trusted and
+ * may still have more sync wakes to issue: each task also remembers which of
+ * its last 16 sync wakes had others join it (see check_preempt_wakeup_fair()).
+ * A wake whose wakee may preempt the waker teaches nothing: the wakee answers
+ * it, so even an honest waker need not block.  Such samples are dropped, and
+ * every 16th wake that would preempt waits instead, to keep learning.
+ */
+#define POC_SYNC_GAIN_SHIFT	10
+#define POC_SYNC_LIE_NS		(1ULL << POC_SYNC_GAIN_SHIFT)
+#define POC_SYNC_LIE_LOG2_MAX	40
+
+enum { POC_SYNC_NO, POC_SYNC_YES };
+
+/* verdict of the wake being placed from this CPU, valid within select_task_rq_fair() */
+static DEFINE_PER_CPU(u8, poc_sync_verdict);
+/* wakee whose sync wake poc_select_wake_cpu() already noted, for wakeup_preempt */
+static DEFINE_PER_CPU(struct task_struct *, poc_sync_noted);
+
+/*
+ * May select_idle_sibling() take its early recent_used_cpu shortcut?  Not
+ * when this wake is to hand the waker's CPU to the wakee (Level 0w), which
+ * the shortcut would pre-empt.
+ */
+static __always_inline bool poc_sync_recent_ok(void)
+{
+	return !static_branch_likely(&poc_selector_active) ||
+	       __this_cpu_read(poc_sync_verdict) == POC_SYNC_NO;
+}
+
+/*
+ * Can @t's promise to sleep right after a sync wake be taken?  Yes if, over
+ * its last 16 sync wakes, what the kept ones gained outweighs what its lies
+ * cost.
+ */
+static inline bool poc_sync_waker_trusted(struct task_struct *t)
+{
+	const struct poc_sync *ps = &t->poc_sync;
+	unsigned int lies = hweight16(ps->hist);
+
+	return (u64)lies << ps->lie_log2 <=
+	       (u64)(16 - lies) << POC_SYNC_GAIN_SHIFT;
+}
+
+/*
+ * May @t still have other tasks to wake before it sleeps?  Yes if any of its
+ * last 16 sync wakes had others issued right behind it.
+ */
+static inline bool poc_sync_waker_busy(struct task_struct *t)
+{
+	return t->poc_sync.chain;
+}
+
+/*
+ * May @p be placed on the CPU of its sync waker?  It will sync-wake the waker
+ * back from there, so it must be a trusted waker itself.  A task that never
+ * issued a sync wake is not judged: how its wakeups are handled is EEVDF's
+ * business.
+ */
+static inline bool poc_sync_wakee_trusted(struct task_struct *p)
+{
+	return !p->poc_sync.sampled || poc_sync_waker_trusted(p);
+}
+
+/* @t's pending sync wake is resolved: @t ran @ran ns of its own CPU after it */
+static inline void poc_sync_resolve(struct task_struct *t, u64 ran)
+{
+	struct poc_sync *ps = &t->poc_sync;
+	bool lie = ran > POC_SYNC_LIE_NS;
+
+	ps->mark = 0;
+	if (ps->on_waker_cpu)
+		return;
+	ps->hist = (ps->hist << 1) | lie;
+	ps->chain = (ps->chain << 1) | ps->joined;
+	ps->sampled = true;
+	if (lie) {
+		int d = min(fls64(ran), POC_SYNC_LIE_LOG2_MAX) - ps->lie_log2;
+
+		/* half way towards this lie, rounding towards it */
+		ps->lie_log2 += d > 0 ? (d + 1) / 2 : (d - 1) / 2;
+	}
+}
+
+/* @p is going to sleep */
+static inline void poc_sync_note_sleep(struct rq *rq, struct task_struct *p)
+{
+	struct sched_entity *se = &p->se;
+	u64 exec = se->sum_exec_runtime;
+
+	if (!p->poc_sync.mark)
+		return;
+	/* read-only: leave update_curr() to whoever else needs it */
+	if (cfs_rq_of(se)->curr == se) {
+		s64 delta = (s64)(rq_clock_task(rq) - se->exec_start);
+
+		exec += delta > 0 ? delta : 0;
+	}
+	poc_sync_resolve(p, exec - (p->poc_sync.mark - 1));
+}
