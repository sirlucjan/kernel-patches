+++ b/drivers/gpu/drm/drm_edid.c
@@ -6598,8 +6598,8 @@ static void drm_get_monitor_range(struct drm_connector *connector,
 		    info->monitor_range.min_vfreq, info->monitor_range.max_vfreq);
