From 0ac8372bb8e5bc081556c447a347a188ccd3700e Mon Sep 17 00:00:00 2001
From: Matthew Schwartz <matthew.schwartz@linux.dev>
Date: Thu, 2 Jul 2026 12:07:05 -0700
Subject: [PATCH 143/188] PCI/PM: Keep MSI Claw 8 EX AI+ SD Express slot Port
 out of runtime D3
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The MSI Claw 8 EX AI+ routes its microSD Express slot to Root Port
0000:00:1c.0 through a Realtek RTS5264 card reader. The reader muxes
either itself (UHS-I cards) or the card's own NVMe controller (SD
Express cards) onto the link, so slot presence is in-band only: the
Port learns of a card solely from the link coming up.

The platform provides RTD3 methods for the Port, so bridge D3 is
otherwise allowed, but neither D3hot nor D3cold keeps link detection
alive, and no wake event is generated when a card is inserted or when
the reader takes the link back after an SD Express card is removed.
Once the Port runtime suspends with the link down, the slot is dead
until a manual rescan or reboot:

  pcieport 0000:00:1c.0: pciehp: Slot(2): Link Down
  pcieport 0000:00:1c.0: pciehp: Slot(2): Card present
  pcieport 0000:00:1c.0: pciehp: Slot(2): No link

Add no_runtime_d3 to struct pci_dev, making the port service driver
refuse runtime suspend when set, and set it for this Port on this
machine. With the Port awake, switching between UHS-I and SD Express
cards works reliably in both directions.

Only runtime D3 is blocked: making pci_bridge_d3_possible() return
false would also keep the Port in D0 across system sleep, because
pci_power_manageable() gates the suspend path on bridge_d3, and that
hangs s2idle entry on this platform. System sleep needs no such
restriction; pciehp re-checks presence on resume.

Assisted-by: Claude:claude-fable-5
Signed-off-by: Matthew Schwartz <matthew.schwartz@linux.dev>
Signed-off-by: Nícolas F. R. A. Prado <nfraprado@collabora.com>
---
 drivers/pci/pcie/portdrv.c |  8 ++++++--
 drivers/pci/quirks.c       | 23 +++++++++++++++++++++++
 include/linux/pci.h        |  1 +
 3 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/drivers/pci/pcie/portdrv.c b/drivers/pci/pcie/portdrv.c
index 2d6aa488f..92bd24da0 100644
--- a/drivers/pci/pcie/portdrv.c
+++ b/drivers/pci/pcie/portdrv.c
@@ -637,7 +637,9 @@ __setup("pcie_ports=", pcie_port_setup);
 #ifdef CONFIG_PM
 static int pcie_port_runtime_suspend(struct device *dev)
 {
-	if (!to_pci_dev(dev)->bridge_d3)
+	struct pci_dev *pdev = to_pci_dev(dev);
+
+	if (!pdev->bridge_d3 || pdev->no_runtime_d3)
 		return -EBUSY;
 
 	return pcie_port_device_runtime_suspend(dev);
@@ -645,12 +647,14 @@ static int pcie_port_runtime_suspend(struct device *dev)
 
 static int pcie_port_runtime_idle(struct device *dev)
 {
+	struct pci_dev *pdev = to_pci_dev(dev);
+
 	/*
 	 * Assume the PCI core has set bridge_d3 whenever it thinks the port
 	 * should be good to go to D3.  Everything else, including moving
 	 * the port to D3, is handled by the PCI core.
 	 */
-	return to_pci_dev(dev)->bridge_d3 ? 0 : -EBUSY;
+	return pdev->bridge_d3 && !pdev->no_runtime_d3 ? 0 : -EBUSY;
 }
 
 static const struct dev_pm_ops pcie_portdrv_pm_ops = {
diff --git a/drivers/pci/quirks.c b/drivers/pci/quirks.c
index 12b0e512c..f686a722f 100644
--- a/drivers/pci/quirks.c
+++ b/drivers/pci/quirks.c
@@ -6396,6 +6396,29 @@ static void pci_fixup_d3cold_delay_1sec(struct pci_dev *pdev)
 }
 DECLARE_PCI_FIXUP_FINAL(0x5555, 0x0004, pci_fixup_d3cold_delay_1sec);
 
+/*
+ * The MSI Claw 8 EX AI+ muxes its microSD Express slot onto this Root
+ * Port through an RTS5264 card reader, with in-band presence only, so
+ * a runtime suspended Port can never see a card change and the slot is
+ * dead until a manual rescan. Block only runtime D3: keeping the Port
+ * in D0 across system sleep hangs s2idle entry here, and pciehp
+ * re-checks presence on resume anyway.
+ */
+static void quirk_sdexpress_no_runtime_d3(struct pci_dev *pdev)
+{
+	if (pdev->devfn != PCI_DEVFN(0x1c, 0))
+		return;
+
+	if (!dmi_match(DMI_SYS_VENDOR, "Micro-Star International Co., Ltd.") ||
+	    !dmi_match(DMI_BOARD_NAME, "MS-1T91"))
+		return;
+
+	pci_info(pdev, "disabling runtime D3 for SD Express slot Port (in-band presence only)\n");
+	pdev->no_runtime_d3 = 1;
+}
+DECLARE_PCI_FIXUP_HEADER(PCI_VENDOR_ID_INTEL, 0xe43a,
+			 quirk_sdexpress_no_runtime_d3);
+
 #ifdef CONFIG_PCIEAER
 static void pci_mask_replay_timer_timeout(struct pci_dev *pdev, struct pci_dev *reporter)
 {
diff --git a/include/linux/pci.h b/include/linux/pci.h
index 64b308b6e..095075db0 100644
--- a/include/linux/pci.h
+++ b/include/linux/pci.h
@@ -415,6 +415,7 @@ struct pci_dev {
 	unsigned int	d2_support:1;	/* Low power state D2 is supported */
 	unsigned int	no_d1d2:1;	/* D1 and D2 are forbidden */
 	unsigned int	no_d3cold:1;	/* D3cold is forbidden */
+	unsigned int	no_runtime_d3:1;	/* Bridge must not enter runtime D3 */
 	unsigned int	bridge_d3:1;	/* Allow D3 for bridge */
 	unsigned int	d3cold_allowed:1;	/* D3cold is allowed by user */
 	unsigned int	mmio_always_on:1;	/* Disallow turning off io/mem
-- 
