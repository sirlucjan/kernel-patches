From 0a45b5cd5f76e893afd76f5ea4abc67e93acd7ef Mon Sep 17 00:00:00 2001
From: Vladislav Nepogodin <nepogodin.vlad@gmail.com>
Date: Sun, 20 Sep 2026 15:55:44 +0400
Subject: [PATCH 47/47] cachy-t2: define apple_bce mod alias for t2bce_core

for existing installs we need to keep legacy compat alias, to be able to
update systems without needing to manually edit modules in mkinitramfs
config.

loading just t2bce_core should be enough for dma and vhci to be also
bundled in the initramfs

Signed-off-by: Vladislav Nepogodin <nepogodin.vlad@gmail.com>
---
 drivers/staging/t2bce/t2bce_core/t2bce_main.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/staging/t2bce/t2bce_core/t2bce_main.c b/drivers/staging/t2bce/t2bce_core/t2bce_main.c
index 6e90a7ea4..d53d1232e 100644
--- a/drivers/staging/t2bce/t2bce_core/t2bce_main.c
+++ b/drivers/staging/t2bce/t2bce_core/t2bce_main.c
@@ -762,5 +762,9 @@ MODULE_AUTHOR("André Eikmeyer <andre.eikmeyer@gmail.com>");
 MODULE_DESCRIPTION("T2 BCE core driver");
 MODULE_VERSION("0.06");
 MODULE_SOFTDEP("post: t2bce_vhci");
+/*
+ * Legacy compat alias for existing installs.
+ */
+MODULE_ALIAS("apple-bce");
 module_init(t2bce_module_init);
 module_exit(t2bce_module_exit);
-- 
2.55.0

