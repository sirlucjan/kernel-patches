+static ssize_t low_swappiness_mode_store(struct kobject *kobj,
+					struct kobj_attribute *attr,
+					const char *buf, size_t count)
+{
+	unsigned int v;
+	int err = kstrtouint(buf, 10, &v);
+
+	if (err)
+		return err;
+	if (v > 1)
+		return -EINVAL;
+	WRITE_ONCE(marie_low_swappiness_mode, v);
+	/* Effective swappiness changed: restart the proportional controller. */
+	lru_marie_swappiness_changed();
+	return count;
+}
+
+static struct kobj_attribute marie_low_swappiness_mode_attr =
+	__ATTR_RW(low_swappiness_mode);
+
+/*
+ * gen_floor_shift -- extra right-shift on the install-cadence floor, 0..6,
+ * default 0.
+ *
+ * The cadence is max(base >> (NR_GENS + 1 - gens), base >> (3 + shift)), so the
+ * two meet at gens == 3 - shift + ... -- concretely, at gens == ilog2(NR_GENS)
+ * minus this value. The knob therefore says one thing: the occupied-generation
+ * count from which the dynamic schedule is allowed to act.
+ *
+ *   0 (default) schedule acts from gens >= 6: a brake near saturation only,
+ *               leaving the cadence below that at one generation per 1/NR_GENS
+ *               of what the type could hold. This is the arm that measured
+ *               clean.
+ *   6 (cap)     floor drops below the schedule's own minimum, so the schedule is
+ *               unfloored and free to accelerate while the ring is empty. This
+ *               is the arm that regressed: the head lapped before reclaim could
+ *               drain behind it and jammed in 3 of 3 runs against 0 of 3, with
+ *               11% more pages swapped.
+ *
+ * In between is unmeasured. The regime it governs -- a ring at or near
+ * saturation -- has not been reproducible in QEMU, while live hardware reaches
+ * it in about twenty minutes, so the knob is here to be swept there. It should
+ * be removed once a value is established, the same way the ignore_refs selector
+ * was once its own question was answered.
+ */
+unsigned int marie_gen_floor_shift;
+
+static ssize_t gen_floor_shift_show(struct kobject *kobj,
+				    struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(marie_gen_floor_shift));
+}
+
+static ssize_t gen_floor_shift_store(struct kobject *kobj,
+				     struct kobj_attribute *attr,
+				     const char *buf, size_t count)
+{
+	unsigned int v;
+	int err = kstrtouint(buf, 0, &v);
+
+	if (err)
+		return err;
+	if (v > MARIE_GEN_FLOOR_SHIFT_MAX)
+		return -EINVAL;
+	WRITE_ONCE(marie_gen_floor_shift, v);
+	return count;
+}
+
+static struct kobj_attribute marie_gen_floor_shift_attr =
+	__ATTR_RW(gen_floor_shift);
+
