+u32 t2bce_core_queue_sq_head(struct t2bce_core_queue_sq *sq);
+u32 t2bce_core_queue_sq_tail(struct t2bce_core_queue_sq *sq);
+u32 t2bce_core_queue_sq_available(struct t2bce_core_queue_sq *sq);
