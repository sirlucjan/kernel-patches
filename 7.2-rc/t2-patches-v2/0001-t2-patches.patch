+
+	scnprintf(newkey, sizeof(newkey), FAN_ID_FMT, to_index(attr));
+
+	ret = applesmc_read_key(newkey, buffer, 16);
+	buffer[16] = 0;
+
+	if (ret)
+		return ret;
+
+	return sysfs_emit(sysfsbuf, "%s\n", buffer + 4);
+}
